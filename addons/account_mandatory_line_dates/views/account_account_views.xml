<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form_inherit_mandatory_line_dates" model="ir.ui.view">
        <field name="name">account.account.form.mandatory.line.dates</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reconcile']" position="after">
                <field name="require_invoice_line_date_range"/>
            </xpath>
        </field>
    </record>
</odoo>
